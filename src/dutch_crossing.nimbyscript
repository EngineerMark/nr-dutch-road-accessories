pub struct CrossingLights extend Signal {}

pub fn CrossingLights::event_signal_texture_state(
    self: &CrossingLights,
    db: &DB,
    signal: &Signal,
    clock_us: i64,
    core_state: i64
): i64 {
    if core_state == 0 {
        return 0;
    }

    return 1 + zmod(zdiv(clock_us, 500000), 2);
}